; RTL generation entry point.

(executables
 (modes byte exe)
 (names generate)
 (libraries
  core.command
  core_unix.command_unix
  core
  hardcaml
  jane_rope
  hardcaml_protemu)
 (modules generate)
 (flags
  (:standard -w -27-57-33-34-35-40-63-47-26-37-32))
 (preprocess
  (pps ppx_hardcaml ppx_jane))
 (lint
  (pps ppx_js_style)))

; Repository command front door: `dune exec protemu -- <command>`. The name is
; bound by the env stanza in the root dune file, so nothing is installed.

(executable
 (name asic_bundle)
 (libraries core hardcaml hardcaml_asic hardcaml_protemu)
 (modules asic_bundle)
 (preprocess
  (pps ppx_hardcaml ppx_jane))
 (lint
  (pps ppx_js_style)))

(executable
 (name protemu)
 (libraries
  core
  core_unix
  core_unix.command_unix
  core_unix.filename_unix
  core_unix.sys_unix)
 (modules protemu)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

; Direct P2 block emitter. Kept separate from the P0 generator and its wrapper.

(executable
 (name generate_p2)
 (libraries core hardcaml jane_rope hardcaml_protemu)
 (modules generate_p2)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

; Standalone P3 core/store-consumer emitter. The RAM remains an external port.

(executable
 (name generate_core)
 (libraries core hardcaml jane_rope hardcaml_protemu)
 (modules generate_core)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))
