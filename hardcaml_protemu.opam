# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Protocol emulator ASIC written in Hardcaml"
description: """
Synthesizable protocol emulator blocks written in Hardcaml. Installs the wrapped RTL
and ISA libraries plus a transport-independent host API and integrated-core simulator
backend."""
maintainer: ["Bohdan Purtell <bohdanpurtell@gmail.com>"]
authors: ["Bohdan Purtell <bohdanpurtell@gmail.com>"]
homepage: "https://github.com/LeEmperor/hardcaml_protemu"
bug-reports: "https://github.com/LeEmperor/hardcaml_protemu/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.17" & >= "3.17"}
  "core"
  "hardcaml"
  "ppx_hardcaml"
  "ppx_jane"
  "hardcaml_step_testbench" {with-test}
  "hardcaml_waveterm" {with-test}
  "hardcaml_event_driven_sim" {with-test}
  "ppx_expect" {with-test}
  "base_quickcheck" {with-test}
  "alcotest" {with-test}
  "core_unix" {with-test}
  "jane_rope" {with-test}
  "hardcaml_asic" {with-test}
  "ppx_js_style" {with-dev-setup}
  "ocamlformat" {with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/LeEmperor/hardcaml_protemu.git"
