(library
 (name protemu_common_tests)
 (wrapped false)
 (modules checker_expect_tests replay_expect_tests)
 ; ppx_expect v0.18~preview drops the directory from a test file's path when registering
 ; the test, then rebuilds it at exit from the bare filename plus -source-tree-root. The
 ; trailing `.` points it at the runner's cwd, where dune has copied the sources. Drop
 ; this if a later ppx_expect fixes the path handling.
 (inline_tests
  (flags
   (:standard -source-tree-root .)))
