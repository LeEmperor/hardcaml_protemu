; Tests for the reference execution model (phase_plan.md P1.1 and P1.2).
;
; A separate library from test/, and with no hardcaml dependency, for the same reason
; model/ is separate from lib/: if the model and the RTL shared a harness they could share
; a mistake. Model/RTL comparison tests belong in test/, which may depend on both.

(library
 (name test_protemu_model)
 (inline_tests
  (flags
   (:standard -source-tree-root .)))
 (libraries core protemu_model)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))
