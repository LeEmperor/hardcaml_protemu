; `dune build @rtl`: checks on the committed wrapper RTL that need host tools
; (iverilog, verilator, yosys). Kept out of runtest so the Hardcaml tests do not
; require them. The Makefile remains for the staged project and gate-level runs.

(rule
 (alias rtl)
 (deps
  tb.v
  ../src/p0_observable.v
  ../src/project.v
  (sandbox always))
 (action
  (progn
   (run
    iverilog
    -g2012
    -Wall
    -Wno-timescale
    -s
    tb
    -o
    p0_wrapper
    ../src/p0_observable.v
    ../src/project.v
    tb.v)
   (run vvp p0_wrapper))))

(rule
 (alias rtl)
 (deps ../src/p0_observable.v ../src/project.v)
 (action
  (run
   verilator
   --lint-only
   --top-module
   tt_um_leemperor_hardcaml_protemu
   -Wno-DECLFILENAME
   ../src/p0_observable.v
   ../src/project.v)))

; Generic synthesis smoke test only. It is not CMOS5L mapped synthesis.

(rule
 (alias rtl)
 (deps ../src/p0_observable.v ../src/project.v)
 (action
  (run
   yosys
   -q
   -p
   "read_verilog ../src/p0_observable.v ../src/project.v; hierarchy -check -top tt_um_leemperor_hardcaml_protemu; synth -top tt_um_leemperor_hardcaml_protemu; stat")))

(rule
 (alias rtl)
 (deps p2_uart_tb.v ../src/uart_tx.generated.v)
 (action
  (progn
   (run
    iverilog
    -g2012
    -Wall
    -s
    p2_uart_tb
    -o
    p2_uart
    ../src/uart_tx.generated.v
    p2_uart_tb.v)
   (run vvp p2_uart))))

; P2.7's first working slice: the frame through the pin bank and the timer, decoded by an
; independent receiver written in Verilog, then diffed against the trace the model and the
; Hardcaml slice agreed on under `dune runtest`.

(rule
 (alias rtl)
 (deps
  p2_uart_slice_tb.v
  ../src/uart_slice.generated.v
  ../../test/integration/uart_slice/uart_frame.trace
  (sandbox always))
 (action
  (progn
   (run
    iverilog
    -g2012
    -Wall
    -s
    p2_uart_slice_tb
    -o
    p2_uart_slice
    ../src/uart_slice.generated.v
    p2_uart_slice_tb.v)
   (run vvp p2_uart_slice)
   ; The system diff, not dune's: dune's would make the trace a target of this rule and
   ; a dependency of its own action, and the whole point of the `rtl` alias is that
   ; nothing here is built unless the HDL tools are being asked for.
   (run
    diff
    -u
    ../../test/integration/uart_slice/uart_frame.trace
    uart_slice_rtl.trace))))

; P3.1a emitted-RTL generation, HDL lint, and generic synthesis smoke. This proves the
; consumer elaborates without an ASIC-library dependency; behavioral evidence remains in
; test/core/protocol_core and backend integration remains P3.1b/P0.7.

(rule
 (alias rtl)
 (deps ../src/protocol_core.generated.v)
 (action
  (progn
   (run
    verilator
    --lint-only
    --top-module
    protocol_core
    -Wno-DECLFILENAME
    ../src/protocol_core.generated.v)
   (run
    yosys
    -q
    -p
    "read_verilog ../src/protocol_core.generated.v; hierarchy -check -top protocol_core; synth -top protocol_core; stat"))))

